# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# PostgreSQL
DB_NAME=bouebdelli_smart_uni
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# API
PORT=5000
# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# Frontend address allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Timezone used to know which class is happening now
TZ=Africa/Tunis

# Face recognition service (ai-service)
AI_SERVICE_URL=http://localhost:8000
# Same value as AI_SERVICE_KEY in ai-service/.env
AI_SERVICE_KEY=change_me_too

# Check-in opens this many minutes before a class starts
CHECKIN_EARLY_MINUTES=15
