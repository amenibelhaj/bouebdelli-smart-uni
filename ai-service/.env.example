# Copy this file to .env

# --- Face recognition service (app.py) ---
AI_HOST=127.0.0.1
AI_PORT=8000
# Same value as AI_SERVICE_KEY in backend/.env
AI_SERVICE_KEY=change_me_too

# --- Door camera box (door_box.py) ---
BACKEND_URL=http://localhost:5000/api
# Key of the box, shown in the admin page "Boîtiers caméra"
DEVICE_KEY=demo-key-b6
CAMERA_INDEX=0
